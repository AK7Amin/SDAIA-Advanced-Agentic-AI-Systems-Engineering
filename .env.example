# انسخ هذا الملف إلى .env واملأ القيم — لا تضع مفاتيح حقيقية هنا

# --- المزوّد (قابل للتبديل بمتغيرات بيئة وحدها، بلا لمس كود) ---
# أي مزوّد يتكلم واجهة OpenAI المتوافقة يعمل: OpenRouter، Mistral، Groq، Together…
LLM_BASE_URL=https://openrouter.ai/api/v1/chat/completions
LLM_MODEL=openai/gpt-oss-20b:free
LLM_API_KEY=
LLM_API_KEY_FALLBACK=

# مثال تبديل المزوّد (استُعمل فعلًا في التقاط الأدلة حين نفدت حصة OpenRouter):
#   LLM_BASE_URL=https://api.mistral.ai/v1/chat/completions
#   LLM_MODEL=mistral-small-latest

# --- أسماء OpenRouter القديمة (تعمل للتوافق الخلفي إن لم تُضبط LLM_API_KEY) ---
OPENROUTER_API_KEY=sk-or-...
OPENROUTER_API_KEY_FALLBACK=sk-or-...

# --- مزوّد ثانٍ للتراجع عند نفاد الحصة (اختياري لكنه مُوصى به) ---
LLM_BASE_URL_2=
LLM_MODEL_2=
LLM_API_KEY_2=

# --- ضبط ---
# سقف التوليد (منخفض جدًا ← محتوى فارغ في نماذج الاستدلال)
LLM_MAX_TOKENS=2000
# حاجز الميزانية لكل وثيقة. أثقل وثيقة في العيّنة استهلكت 7 نداءات (انظر
# metrics-snapshot.json)، والحد 12 هامش أمان يستوعب حلقتي الاستخراج وReflexion.
MAX_LLM_CALLS_PER_DOC=12
# اعتمادا الخدمة. بلا ضبطهما تُغلق نقطتا النهاية (503) بدل أن تعملا مكشوفتين.
API_TOKEN=              # يحرس POST /process (ينفق حصة نموذج ويكتب على القرص)
APPROVAL_API_TOKEN=     # يحرس POST /resume (يعتمد عقودًا مخالفة)
